<!DOCTYPE html>
<html lang="{{ app.request.locale|slice(0, 2) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'jw.doi.confirmed.title'|trans }}</title>
    <style>
        body { font: 16px/1.5 Helvetica, Arial, sans-serif; color: #333; background: #eee; margin: 0; padding: 40px 16px; }
